{
  "name": "saferoute-react-native",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "jest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:hotlines",
    "sync:hotlines": "node --no-warnings scripts/sync-hotlines.mjs",
    "check:hotlines": "node --no-warnings scripts/sync-hotlines.mjs --check",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore --project saferoute-aibc \"node --test firestore-tests/rules.test.mjs\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.2",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-contacts": "~14.0.5",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-modules-core": "~2.2.3",
    "expo-share-intent": "^3.2.3",
    "expo-speech": "~13.0.1",
    "expo-status-bar": "~2.0.1",
    "firebase": "^11.10.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "shield-module": "file:./modules/shield-module"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^8.0.7",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~8.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/modules/",
      "/server/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|shield-module))"
    ]
  }
}
