rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function text(value, max) {
      return value is string && value.size() <= max;
    }
    function shortId(id) {
      return id.size() <= 100;
    }
    function slimHistory(d) {
      return d.keys().hasOnly(['createdAt', 'language', 'kind', 'verdict', 'scoreBucket', 'scamType', 'title', 'summary'])
        && d.keys().hasAll(['createdAt', 'language', 'kind', 'verdict', 'scoreBucket', 'scamType', 'title', 'summary'])
        && text(d.createdAt, 40)
        && text(d.language, 8)
        && d.kind in ['job', 'message', 'link', 'shop', 'agency', 'screen']
        && d.verdict in ['safe', 'careful', 'danger']
        && d.scoreBucket in [0, 20, 40, 60, 80]
        && text(d.scamType, 40)
        && text(d.title, 300)
        && text(d.summary, 2000);
    }
    function legacyHistory(d) {
      return d.keys().hasOnly(['createdAt', 'language', 'source', 'report'])
        && d.keys().hasAll(['createdAt', 'language', 'report'])
        && text(d.createdAt, 40)
        && text(d.language, 8)
        && text(d.report, 60000)
        && (!('source' in d) || text(d.source, 200));
    }

    match /users/{uid} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['language', 'homeCountry', 'destinationCountry', 'updatedAt'])
        && request.resource.data.keys().hasAll(['language', 'updatedAt'])
        && text(request.resource.data.language, 8)
        && text(request.resource.data.updatedAt, 40)
        && (!('homeCountry' in request.resource.data) || text(request.resource.data.homeCountry, 8))
        && (!('destinationCountry' in request.resource.data) || text(request.resource.data.destinationCountry, 8));

      match /history/{id} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid) && shortId(id) && (slimHistory(request.resource.data) || legacyHistory(request.resource.data));
      }

      match /contacts/{id} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid) && shortId(id)
          && request.resource.data.keys().hasOnly(['name', 'phone', 'updatedAt'])
          && request.resource.data.keys().hasAll(['name', 'phone', 'updatedAt'])
          && text(request.resource.data.name, 80)
          && text(request.resource.data.phone, 24)
          && text(request.resource.data.updatedAt, 40);
      }
    }

    match /config/{doc} {
      allow read, write: if false;
    }
    match /config_drafts/{id} {
      allow read, write: if false;
    }
    match /config_audit/{id} {
      allow read, write: if false;
    }
    match /admins/{uid} {
      allow read, write: if false;
    }
  }
}
