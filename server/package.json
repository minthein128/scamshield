{
  "name": "saferoute-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test eval ../bench",
    "format": "biome check --write src test",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "smoke": "tsx src/smoke.ts",
    "eval": "tsx eval/run.ts",
    "eval:redaction": "tsx eval/redaction.ts",
    "intel:seed": "tsx src/intel/seed.ts",
    "intel:purge-seed": "tsx src/intel/purge-seed.ts",
    "intel:sweep": "tsx src/intel/sweep.ts",
    "feedback:report": "tsx src/feedback/report.ts",
    "feedback:export": "tsx src/feedback/export.ts",
    "bench": "tsx ../bench/run.ts",
    "bench:labels": "tsx ../bench/labels.ts",
    "bench:report": "tsx ../bench/report.ts",
    "live:smoke": "tsx eval/live-smoke.ts"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "@hono/node-server": "^2.1.5",
    "@types/ws": "^8.18.2",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.0",
    "hono": "^4.13.13",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
