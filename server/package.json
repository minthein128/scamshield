{
  "name": "saferoute-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "@hono/node-server": "^2.1.5",
    "google-auth-library": "^11.3.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}